# Copy to .env and fill in. Never commit .env.

# --- Model ---------------------------------------------------------------
# azure_openai | foundry | openai
FACTORY_PROVIDER=azure_openai
# Deployment name (Azure OpenAI / Foundry) or model name (OpenAI)
FACTORY_MODEL=

# Azure OpenAI. Leave the key empty to sign in with `az login` instead.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=

# Microsoft Foundry (uses `az login`)
FOUNDRY_PROJECT_ENDPOINT=

# OpenAI, or a private endpoint that speaks the OpenAI API (FACTORY_PROVIDER=openai)
OPENAI_API_KEY=
# Leave empty for api.openai.com. For a private endpoint, the base address, usually ending in /v1
OPENAI_BASE_URL=
# responses (default) or chat_completions. Use chat_completions if the endpoint only offers /chat/completions
OPENAI_API_STYLE=responses

# --- MCP servers (see mcp.json) --------------------------------------------
# Connection string the DocumentDB MCP server uses. A local or dev cluster.
DOCUMENTDB_URI=

# --- Optional --------------------------------------------------------------
# Folders that hold agent skills, comma separated. Default: .agents/skills and skills
# FACTORY_SKILL_PATHS=
# Executables the builder may run, comma separated
# FACTORY_ALLOWED_COMMANDS=python,pip,pytest,node,npm,npx,dotnet,git,az,azd,docker,mongosh,terraform,bicep
# Let the builder create and change Azure resources (same as --allow-azure-writes)
# FACTORY_ALLOW_AZURE_WRITES=false
# Model round-trips allowed for the builder and auditor
# FACTORY_BUILDER_MAX_ITERATIONS=150
# Seconds to wait for one model answer before giving up
# FACTORY_REQUEST_TIMEOUT=1800
# How many prior beliefs the audit checks against public sources
# FACTORY_MAX_PRIOR_BELIEFS=25
